# Copy to .env and set ONE key (or none: the optimizer + priority ladder then decide on their own).
# Claude API usage is billed separately from a Claude.ai subscription; Groq and Gemini have free tiers.
ANTHROPIC_API_KEY=
GROQ_API_KEY=            # free: https://console.groq.com/keys   (default model llama-3.3-70b-versatile)
GEMINI_API_KEY=          # free: https://aistudio.google.com     (default model gemini-2.5-flash)
OPENROUTER_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1   # local Ollama or any OpenAI-compatible server
# LLM_MODEL=                              # optional model override
# LLM_PROVIDER=                           # optional: anthropic | groq | gemini | openrouter
